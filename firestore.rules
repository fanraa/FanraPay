rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Fungsi untuk mengecek apakah user yang login adalah pemilik (Owner)
    function isOwner() {
      return request.auth != null && 
             (request.auth.token.email == 'irfanrizkiaditri@gmail.com' || 
              request.auth.token.email == 'irfanrizkiaditri02@gmail.com');
    }
    
    match /fanra/{document=**} {
      // Hanya anggota yang login menggunakan akun Google (siapa saja) yang bisa melihat data (Viewer)
      allow read: if request.auth != null;
      
      // HANYA Owner (Irfan) yang bisa menulis, mengubah, atau menghapus data
      allow write: if isOwner();
    }
  }
}
